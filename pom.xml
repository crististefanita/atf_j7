<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>ro.atf</groupId>
    <artifactId>chess-lab</artifactId>
    <version>0.5.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules><module>atf-tests</module></modules>
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>3.2.0</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>bootstrap-atf-core</id>
                        <phase>initialize</phase>
                        <goals><goal>install-file</goal></goals>
                        <configuration>
                            <file>${project.basedir}/lib/atf-core-1.0.0-c4.jar</file>
                            <pomFile>${project.basedir}/lib/atf-core-1.0.0-c4.pom</pomFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>bootstrap-atf-reporting</id>
                        <phase>initialize</phase>
                        <goals><goal>install-file</goal></goals>
                        <configuration>
                            <file>${project.basedir}/lib/atf-reporting-1.0.0-j24.jar</file>
                            <pomFile>${project.basedir}/lib/atf-reporting-1.0.0-j24.pom</pomFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>bootstrap-atf-console</id>
                        <phase>initialize</phase>
                        <goals><goal>install-file</goal></goals>
                        <configuration>
                            <file>${project.basedir}/lib/atf-console-1.0.0-c2.jar</file>
                            <pomFile>${project.basedir}/lib/atf-console-1.0.0-c2.pom</pomFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>bootstrap-atf-mock</id>
                        <phase>initialize</phase>
                        <goals><goal>install-file</goal></goals>
                        <configuration>
                            <file>${project.basedir}/lib/atf-mock-1.0.0-m2.jar</file>
                            <pomFile>${project.basedir}/lib/atf-mock-1.0.0-m2.pom</pomFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>bootstrap-atf-test-kit</id>
                        <phase>initialize</phase>
                        <goals><goal>install-file</goal></goals>
                        <configuration>
                            <file>${project.basedir}/lib/atf-test-kit-1.0.0-k2.jar</file>
                            <pomFile>${project.basedir}/lib/atf-test-kit-1.0.0-k2.pom</pomFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
