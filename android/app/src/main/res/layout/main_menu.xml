<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:text="@string/app_name" android:textColor="#f5f3ec"
            android:textSize="30sp" android:textStyle="bold" />
        <TextView style="@style/MenuSection" android:text="@string/menu_play" />
        <Button android:id="@+id/new_match" style="@style/ChapterEntry" android:text="@string/new_match" />
        <Button android:id="@+id/resume_match" style="@style/ChapterEntry" android:text="@string/resume_match" android:visibility="gone" />
        <Button android:id="@+id/open_puzzles" style="@style/ChapterEntry" android:text="@string/menu_puzzles" />
        <TextView android:id="@+id/home_totals" style="@style/ChapterTotals" android:textColor="#b8d88a" />
        <Button android:id="@+id/open_openings" style="@style/ChapterEntry" android:text="@string/openings_title" />
        <TextView style="@style/MenuSection" android:text="@string/profile_title" />
        <Button android:id="@+id/edit_player_name" style="@style/ChapterEntry" />
    </LinearLayout>
</ScrollView>
